-- Retention by year
SELECT EntryTerm,
       COUNT(*) AS CohortSize,
       SUM(CASE WHEN RetainedNextYear = 'Yes' THEN 1 ELSE 0 END) AS Retained,
       ROUND(SUM(CASE WHEN RetainedNextYear = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS RetentionRate
FROM retention
GROUP BY EntryTerm
ORDER BY EntryTerm;

-- Retention by demographic group
SELECT Gender,
       Ethnicity,
       FirstGen,
       ROUND(SUM(CASE WHEN RetainedNextYear = 'Yes' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS RetentionRate
FROM retention
GROUP BY Gender, Ethnicity, FirstGen;
